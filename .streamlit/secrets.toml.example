# Copy to .streamlit/secrets.toml (never commit the real file).

[supabase]
url = "https://your-project.supabase.co"
api_key = "your_supabase_api_key"

[gemini]
api_key = "your_gemini_api_key"
# Optional. Defaults to "gemini-flash-latest" (always Google's current Flash model).
# Pin a specific model id here for reproducible behaviour.
# model = "gemini-flash-latest"
